# ----------------------------------------------------------------------------
# CourtReach — PRODUCTION environment variables
# Set these in the Railway dashboard for each service. Never commit real secrets.
# Variables marked [auto] are injected automatically by Railway's managed services
# via reference variables — you don't need to type them manually.
# ----------------------------------------------------------------------------

# ============================================================================
# API SERVICE (apps/api)
# ============================================================================

NODE_ENV=production

# [auto] Injected by Railway's PostgreSQL service as ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# [auto] Injected by Railway's Redis service as ${{Redis.REDIS_URL}}
REDIS_URL=

# [auto] Injected by Railway — your server reads PORT ?? API_PORT, so this is handled
# API_PORT=4000  ← only needed if you want to override

# Set to the Railway public domain of the courtreach-web service (no trailing slash)
WEB_ORIGIN=https://your-web-service.up.railway.app

# --- Auth ---
# Generate a new one: openssl rand -hex 32  (or any 32+ char random string)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- AI provider ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Contact finder ---
HUNTER_API_KEY=your-hunter-api-key

# --- Discovery ---
DISCOVERY_SOURCE=google
GOOGLE_PLACES_API_KEY=your-google-places-key
# Or use free Overpass: DISCOVERY_SOURCE=overpass (no key needed)
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.openstreetmap.ru/api/interpreter

# --- Email sending (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=CourtReach
SMTP_FROM_EMAIL=your-email@gmail.com

# --- Reply detection (IMAP; optional) ---
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=

# ============================================================================
# WEB SERVICE (apps/web)
# ============================================================================

NODE_ENV=production

# CRITICAL: This is a Docker build ARG — it must be set BEFORE Railway builds
# the image. Set it to the Railway public domain of the courtreach-api service.
NEXT_PUBLIC_API_URL=https://your-api-service.up.railway.app
